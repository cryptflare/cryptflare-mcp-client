{
  "name": "@cryptflare/mcp-client",
  "version": "0.2.2",
  "description": "TypeScript client for the CryptFlare MCP server. Lets agents (Claude, Cursor, Zed) call the typed MCP tool facade over the CryptFlare REST API.",
  "license": "Apache-2.0",
  "author": {
    "name": "Sacha Roussakis-Notter",
    "email": "support@cryptflare.com",
    "url": "https://cryptflare.com"
  },
  "homepage": "https://cryptflare.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptflare/cryptflare-mcp-client.git"
  },
  "bugs": {
    "url": "https://github.com/cryptflare/cryptflare-mcp-client/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cryptflare",
    "secrets",
    "secrets-management",
    "ai",
    "claude"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "module": "./dist/index.js"
}
